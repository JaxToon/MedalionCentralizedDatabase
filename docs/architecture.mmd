%% Banking Enterprise Data Lakehouse Simulator — Final Tech Stack Architecture (MVP)
%% Source: docs/PRD.md (sections 8, 10, 13, 16, 19, 20, 22)
%% Solid lines = MVP. Dashed lines/boxes = deferred future work (PRD section 22), NOT part of v1.

flowchart LR
    %% ---------- Actors ----------
    subgraph USERS["Demo Users - seeded, mock login / role switch"]
        direction TB
        U1["Data Submitter"]
        U2["Data Steward"]
        U3["Platform Admin"]
        U4["Security Reviewer"]
        U5["Central Data Consumer"]
    end

    BROWSER["Web Browser<br/>localhost:8501"]
    USERS --> BROWSER

    %% ---------- Local host ----------
    subgraph HOST["Developer Laptop - Docker Compose: docker-compose.yml + .env"]
        direction LR

        %% ---- Frontend container ----
        subgraph FE["Container: frontend - Python 3.11"]
            direction TB
            ST["Streamlit<br/>Home.py + pages/"]
            PL["Plotly<br/>dashboard charts"]
            PAGES["Pages: Overview, Submit Dataset, My Datasets,<br/>Processing Console, Data Catalog,<br/>Access Requests, Lineage View, Audit Log"]
            ST --- PL
            ST --- PAGES
        end

        %% ---- API container ----
        subgraph BE["Container: api - FastAPI on Uvicorn, localhost:8000"]
            direction TB
            API["FastAPI routers<br/>/api/v1/* + Pydantic schemas"]
            SEC["core/security.py<br/>demo identity + server-side RBAC<br/>grant validity check"]
            LOG["core/logging.py<br/>structured logs, request_id, actor_id"]

            subgraph SVC["services/"]
                direction TB
                S1["ingestion_service<br/>upload, size/type check,<br/>SHA-256 checksum, schema inspect"]
                S2["catalog_service<br/>published Gold search"]
                S3["governance_service<br/>access request, approval,<br/>time-bound grant, audit"]
                S4["lineage_service<br/>object-to-object lineage"]
            end

            subgraph PROC["processing/ - in-process, no scheduler in MVP"]
                direction TB
                P1["bronze.py<br/>keep original + Parquet copy"]
                P2["silver.py<br/>snake_case, trim, typed casts,<br/>dedupe, reject rows"]
                P3["gold.py<br/>predefined aggregation templates"]
                P4["quality.py<br/>required cols, type, null,<br/>duplicate key, row-count, non-negative"]
                ENG["DuckDB + PyArrow + Pandas"]
                P1 --> P2 --> P3
                P2 -.-> P4
                P1 & P2 & P3 & P4 --- ENG
            end

            ORM["SQLAlchemy 2 ORM + psycopg<br/>db/models, db/repositories"]

            API --> SEC
            API --> SVC
            API --> LOG
            S1 --> PROC
            SVC --> ORM
            PROC --> ORM
        end

        %% ---- Database container ----
        subgraph DBC["Container: db - postgres:16, host port 5433 to container 5432"]
            PG[("PostgreSQL<br/>metadata + control plane only<br/>see docs/erd.mmd")]
        end
        MIG["Alembic migrations/<br/>schema + constraints"]
        SEED["scripts/<br/>seed_demo_data.py<br/>generate_synthetic_data.py"]

        %% ---- Storage volume ----
        subgraph FS["Bind mount: ./storage - gitignored, local filesystem"]
            direction TB
            L["landing/ - raw CSV / JSON"]
            B["bronze/ - original + Parquet"]
            SV["silver/ - Parquet"]
            G["gold/ - Parquet data products"]
            Q["quarantine/ - rejected.parquet"]
        end
    end

    %% ---------- Main wiring ----------
    BROWSER -->|HTTP| ST
    ST -->|"REST JSON via httpx<br/>X-Demo-User header"| API
    ORM -->|SQL| PG
    MIG -->|migrate| PG
    SEED -->|seed users, roles, domains| PG
    SEED -->|synthetic CSV files| L

    S1 -->|write source| L
    P1 -->|read landing / write| B
    P2 -->|write| SV
    P2 -->|rejected rows| Q
    P3 -->|write| G
    S2 -->|"safe Gold preview,<br/>only with valid grant"| G

    %% ---------- Dev tooling ----------
    subgraph DEV["Dev and Quality Tooling"]
        direction TB
        UV["uv / pip + requirements.txt"]
        PYT["Pytest<br/>unit, integration, e2e"]
        GIT["Git + GitHub<br/>no .env committed"]
    end
    PYT -.->|tests| BE
    PYT -.->|test DB| PG

    %% ---------- Future work (deferred) ----------
    subgraph FUT["Future Work - post-MVP, PRD section 22"]
        direction TB
        F1["MinIO / S3-compatible storage"]
        F2["Apache Iceberg tables"]
        F3["Prefect or Airflow scheduling"]
        F4["Debezium + Kafka CDC"]
        F5["Trino SQL access"]
    end
    FS -.->|replace with| F1
    F1 -.-> F2
    F2 -.-> F5
    F3 -.->|orchestrate| PROC
    F4 -.->|stream into| L

    %% ---------- Styling ----------
    classDef actor fill:#E8F0FE,stroke:#1A73E8,color:#0B3D91
    classDef fe fill:#FFF4E5,stroke:#F29900,color:#5F3B00
    classDef be fill:#E6F4EA,stroke:#188038,color:#0D3B1E
    classDef db fill:#F3E8FD,stroke:#8E24AA,color:#3C0A49
    classDef bronze fill:#F6E3D4,stroke:#A0522D,color:#4A2511
    classDef silver fill:#ECEFF1,stroke:#78909C,color:#263238
    classDef gold fill:#FFF8D6,stroke:#C9A400,color:#4D3F00
    classDef quarantine fill:#FCE8E6,stroke:#D93025,color:#5C0F0A
    classDef tool fill:#F1F3F4,stroke:#5F6368,color:#202124
    classDef future fill:#FFFFFF,stroke:#9AA0A6,color:#5F6368,stroke-dasharray:5 5

    class U1,U2,U3,U4,U5,BROWSER actor
    class ST,PL,PAGES fe
    class API,SEC,LOG,S1,S2,S3,S4,P1,P2,P3,P4,ENG,ORM be
    class PG,MIG,SEED db
    class L,B bronze
    class SV silver
    class G gold
    class Q quarantine
    class UV,PYT,GIT tool
    class F1,F2,F3,F4,F5 future
