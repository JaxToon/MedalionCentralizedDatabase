# Copy to .env and adjust. Never commit .env.
# Placeholder credentials for the local demo database only.

# PostgreSQL (used by the db container and by the api)
POSTGRES_USER=lakehouse
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=lakehouse

# Where host-side tools (pytest, DBeaver, the seed run outside Docker) reach Postgres.
# Docker publishes the db container on host port 5433 because a native PostgreSQL
# may already own 5432. Inside Compose the api overrides these to db:5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Application log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Where the Streamlit frontend reaches the API. Compose sets http://api:8000.
API_BASE_URL=http://localhost:8000
